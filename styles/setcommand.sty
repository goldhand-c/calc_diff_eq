\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{setcommand}[2026/07/25 Custom Commands]

\providecommand{\quoteI}[1]{``#1''} % "" quotes
\providecommand{\quotei}[1]{`#1'} % '' quotes

\providecommand{\lfi}{ﬁ} % manual ligatures
\providecommand{\ff}{ﬀ}
\providecommand{\ffi}{ﬃ}
\providecommand{\fl}{ﬂ}
\providecommand{\ffl}{ﬄ}

\newcommand{\qmarki}[1]{\mbox{(#1 คะแนน)}}
\newcommand{\qmark}[1]{{%
            \unskip\nobreak\hfil\penalty50
            \hskip2em\hbox{}\nobreak\hfil\qmarki{#1}%
            \parfillskip=0pt \finalhyphendemerits=0 \par}}

\newcommand{\makeheading}[1]{
    \thispagestyle{empty}
    \vspace*{-6em}

    {\centering\fbox{\parbox[c][1.6em]{.983\textwidth}{\centering\bfseries #1}}\par}
}

% -------- MATH --------
% Colored aligned box (need mathtools pkg)
\newcommand*\Acolorboxed[2][red]{%
    \let\bgroup{\romannumeral-`}%
    \@Acolorboxed{#1}#2&&\ENDDNE
}
\def\@Acolorboxed#1#2&#3&#4\ENDDNE{%
    \ifnum0=`{}\fi
    \setbox\z@\hbox{$\displaystyle#2{}\m@th$\kern\fboxsep \kern\fboxrule}%
    \edef\@tempa{\kern\wd\z@ & \kern-\the\wd\z@ \fboxsep\the\fboxsep \fboxrule\the\fboxrule}%
    \@tempa
    \fcolorbox{#1}{white}{\m@th$\displaystyle#2#3$}%
}


\endinput


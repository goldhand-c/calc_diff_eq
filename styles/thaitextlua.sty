\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thaitext}[2026/06/27 Language Options for LuaLaTeX]

%% Language settings

\RequirePackage{fontspec}    % font support
\RequirePackage{polyglossia} % language support

\setmainlanguage{english}
\setotherlanguage{thai}


% -------- CHINESE / JAPANESE / KOREAN --------
\usepackage{ruby} % Japanese ruby
\renewcommand{\rubysize}{0.4}    % adjusts size of furigana
\renewcommand{\rubysep}{-0.55ex} % vertical separation


% -------- ENGLISH --------
%% SET COMPONENT FONTS FOR ENGLISH
\setmainfont{mlm}[ % thick latin modern
    Extension = .ttf,
    UprightFont = *r9,
    BoldFont = *bx10,
    ItalicFont = *ri9,
    BoldItalicFont = *bxi10,
    SlantedFont = *ro9,
    SmallCapsFont = *csc10,
    SwashFont = mlmu10
]

% \setmonofont{mlmtt}[ % thick typewriter font
%   Extension = .ttf,
%   UprightFont = *12,
%   ItalicFont = *i10
% ]

\setsansfont{NebulaSans}[Extension=.ttf,Scale=0.9,UprightFont=*-Book,BoldFont=*-Bold,ItalicFont=*-BookItalic,BoldItalicFont=*-BoldItalic]


% ------------------- THAI -------------------
%% DEFINE THE THAI FONT
\newfontfamily{\thaifont}{THSarabunNew}[
    Path = ./fonts/Thai/,
    Extension = .ttf,
    UprightFont = *,
    BoldFont = *-Bold,
    ItalicFont = *-Italic,
    BoldItalicFont = *-BoldItalic,
    Script = Thai,
    Scale = MatchLowercase
]

%% Set environment for Thai fonts
\newenvironment{thailang}{\thaifont}{}

% \AtBeginEnvironment{thai}{\begin{spacing}{1.25}} % adjust thai spacing
% \AtEndEnvironment{thai}{\end{spacing}}

% IBM Plex Sans font for Thai
\newfontfamily{\ibmplexsans}{IBMPlexSans}[
    Extension = .ttf,
    UprightFont = *-Regular,
    BoldFont = *-Bold,
    ItalicFont = *-Italic,
    BoldItalicFont = *-BoldItalic,
    Numbers=OldStyle
]


\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{setupsci}[2026/07/25 Science Options]

% -------- FIGURES ---------
\RequirePackage{graphicx, tikz, pgf, float} % pictures, figures
\usetikzlibrary{
    arrows.meta, % arrow heads
    calc,
    % math, % tikzmath
    angles,
    positioning,
    % shapes.geometric,
    % decorations.text % text along path
}
% \RequirePackage{wrapfig}


% -------- PLOTS --------
\RequirePackage{pgfplots}
\pgfplotsset{
    compat=1.18,
    %   scale only axis,
    %   axis lines=middle,  % axes cross origin
    %   axis equal image,   % same X and Y scale
    %   % xtick distance=1,
    %   % ytick distance=1,
    %   % every axis title shift=3pt,
    %   % title style={font=\large},
    %   % grid=major,        % grid at major ticks
    %   % enlargelimits=0.1, % padding
    %   % label style={font=\small},
    %   % legend style={font=\small},
    %   % ticklabel style={font=\footnotesize}    
}
% \usepgfplotslibrary{fillbetween} % area under curves

% \RequirePackage{pgfplotstable} % process table


% -------- MATH ---------
\RequirePackage{amsmath, amssymb, amsthm} % mathematics
% Check out math fonts in setuptext.sty/FONTS

\RequirePackage{esint} % extra integrals

% \RequirePackage{upgreek} upright Greek \upalpha \upbeta

\RequirePackage{mathtools} % extension to amsmath
%% Use \parens*[<size>]{<expr>} starred for auto scale
\DeclarePairedDelimiter\parens{(}{)}            % parentheses
\DeclarePairedDelimiter\brac{[}{]}              % square brackets
\DeclarePairedDelimiter\curly{\{}{\}}           % curly braces
\DeclarePairedDelimiter\tri{\langle}{\rangle}   % angle braces
\DeclarePairedDelimiter\ceil{\lceil}{\rceil}    % ceiling fn
\DeclarePairedDelimiter\floor{\lfloor}{\rfloor} % floor fn
\DeclarePairedDelimiter\round{\lfloor}{\rceil}  % round fn
%% The \abs (absolute) and \norm (vector) are in physics package (no need *)


% -------- PHYSICS ---------
% \RequirePackage[siunitx]{circuitikz}
% \ctikzset{
%   quadpoles/transformer core/width=1.1,
%   quadpoles/transformer core/height=1.428,
%   inductors/coils=4,
%   inductors/width=0.9
% }

\RequirePackage{siunitx}
\sisetup{             % SI units
    per-mode=symbol,    % \per : symbol power fraction
    range-phrase=--,
    range-units=single,
    product-units=single,
    list-units=single,
    % exponent-product = \cdot,
    mode = math,
    unit-mode = math,
    reset-math-version = false,
    % free-standing-units, % re-enables macros
    % overwrite-functions  % replace units
}

\RequirePackage[notrig]{physics} %  typesetting equation shortcut
% \AtBeginDocument{\RenewCommandCopy\qty\SI} % avoid clash with siunitx
\ExplSyntaxOn % suppress warning message
\msg_redirect_name:nnn {siunitx} {physics-pkg} {none}
\ExplSyntaxOff

% \renewcommand{\hbar}{\mkern5mu\bar{}\mkern-5mu h} % fix hbar in case of wrong font

\RequirePackage{cancel} % bcancel xcancel cancelto

\endinput


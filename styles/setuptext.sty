% -------- LIST --------
\RequirePackage{enumitem} % enum label
\newlist{question}{enumerate}{2}
\newlist{choice}{enumerate}{1}
\setlist[question,1]{
    labelindent=0pt, % 0pt
    labelwidth=\widthof{00.},
    label=\arabic*.,
    itemindent=*,
    leftmargin=!,
    topsep=1pt,
    align=left,
    itemsep=2em % 1em
}
\setlist[question,2]{
    label=\thequestioni\arabic*,
    itemsep=2em,
    align=left
}
\setlist[choice,1]{
    labelindent=*,
    labelwidth=\widthof{0.},
    labelsep=8pt,
    label=\arabic*.,
    itemindent=1em,
    leftmargin=2em, % * for no indent
    itemsep=1pt,
    topsep=1pt,
    align=right
}
\setlist[itemize,1]{
    itemsep=3pt,
    topsep=0pt
}


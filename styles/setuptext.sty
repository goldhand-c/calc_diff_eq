\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{setuptext}[2026/04/15 Text Options]

% -------- SPACING --------
\raggedbottom % no vertical justification
\RequirePackage{calc} % setcounter / setlength / widthof
\RequirePackage{indentfirst} % force indent
%% (must use before polyglossia/ragged2e)

\RequirePackage[normalem]{ulem} % uline uuline uwave sout xout dashuline dotuline
\useunder{\uline}{\ulined}{}    % ulined switch command
\RequirePackage{xhfill} % line fill \xrfill[raise]{width}[color]

% \RequirePackage{censor} % censor censorbox blackout
% \StopCensoring % turn off censor

\RequirePackage{setspace} % begin spacing 1.5
% \setstretch{1.618}         % line spacing
\onehalfspacing              % single/onehalf/double spacing
\setlength\headheight{62pt}  % header height
\setlength\footskip{34pt}    % space before base of footer
\setlength\parskip{1em} % paragraph spacing
\setlength\parindent{0.75cm} % indent length
% \setlength{\hoffset}{60pt} % left side page area spacing
% \setlength\textheight{9.19in} % text-area height

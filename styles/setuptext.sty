\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{setuptext}[2026/07/25 Text Options]

% -------- SPACING --------
% \raggedbottom % no vertical justification
\RequirePackage{calc} % setcounter / setlength / widthof
\RequirePackage{indentfirst} % force indent
%% (must use before polyglossia/ragged2e)

\RequirePackage[normalem]{ulem} % uline uuline uwave sout xout dashuline dotuline
\useunder{\uline}{\ulined}{}    % ulined switch command
\RequirePackage{xhfill} % line fill \xrfill[raise]{width}[color]

\RequirePackage{setspace} % begin spacing 1.5
% \setstretch{1.618}         % line spacing
\onehalfspacing              % single/onehalf/double spacing
\setlength\headheight{62pt}  % header height
\setlength\footskip{34pt}    % space before base of footer
\setlength\parskip{1em} % paragraph spacing
\setlength\parindent{0.75cm} % indent length
% \setlength{\hoffset}{60pt} % left side page area spacing
% \setlength\textheight{9.19in} % text-area height
% \setlength\textwidth{426pt}   % text-area width

\RequirePackage{printlen} % print length in a variety of units
%% \uselengthunit{in} \printlength{\textwidth}

% \spaceskip=\fontdimen2\font plus 0.75em minus 0pt % length of white space
%% \spaceskip=\fontdimen2\font plus \fontdimen3\font minus 0pt % recommended
% \tolerance=2000 % badness per line (default 200)
% \emergencystretch=2em % use settings with sans serif font

% \RequirePackage[dvipsnames]{xcolor} % define colors (dvipsnames for 68 named colors)


% -------- PAGE --------
\RequirePackage{lipsum, ragged2e} % minipage / raggedright

\RequirePackage{multicol} % page columns \begin{multicols*}{2} \columnbreak
% \setlength{\columnsep}{12pt}      % distance between columns
% \setlength{\columnseprule}{0.6pt} % thickness of vertical rule
% \def\columnseprulecolor{\color{blue}} % rule color

\RequirePackage{fancyhdr}   % header
\pagestyle{fancy}           % activate header
% \fancyhfoffset[L,R]{1cm}  % expand outside text area
% \renewcommand{\headrulewidth}{0.5pt} % width of header line
% \renewcommand{\footrulewidth}{0.5pt} % width of footer line
% \renewcommand{\headrule}{{\color{black!80}\hrule width\headwidth height\headrulewidth \vskip-\headrulewidth}}

\RequirePackage{titling} % pretitle posttitle thetitle theauthor thedate
\appendiargdef{\title}{% avoid clash with titlesec
    \begingroup
    \protected@xdef\titlename{#1}
    \endgroup
}

\RequirePackage{pdfpages} % \includepdf[pages=-]{All.pdf}


% -------- MATH FONTS --------
% MLModern
\RequirePackage[T1]{fontenc} % use T1 fonts
\RequirePackage{mlmodern}    % set math fonts to thick Modern (all fonts only in pdfLaTeX, don't use unicode-math)
\AtBeginDocument{
    \RequirePackage{mathspec} % help math symbol fonts mlmodern (must load after physics)
}


% -------- REFERENCE --------
\RequirePackage[pdfusetitle]{hyperref} % link
\hypersetup{
    %    colorlinks=true,   % text coloring instead of boxes
    %    linkcolor=blue,    % internal links
    %    urlcolor=cyan,     % web addresses \url
    %    filecolor=magenta, % local files
    %    citecolor=green,   % bibliographical citations
    hidelinks          % removes all format
}

% \RequirePackage{cleverref} % ref section, figure
\RequirePackage{lastpage} % ref \pageref*{LastPage}


% -------- LIST --------
\RequirePackage{enumitem} % enum label
\newlist{question}{enumerate}{2}
\newlist{choice}{enumerate}{1}
\setlist[question,1]{
    labelindent=0pt, % 0pt
    labelwidth=\widthof{00.},
    label=\arabic*.,
    itemindent=*,
    leftmargin=!,
    topsep=1pt,
    align=left,
    itemsep=2em % 1em
}
\setlist[question,2]{
    label=\thequestioni\arabic*,
    itemsep=2em,
    align=left
}
\setlist[choice,1]{
    labelindent=*,
    labelwidth=\widthof{0.},
    labelsep=8pt,
    label=\arabic*.,
    itemindent=1em,
    leftmargin=2em, % * for no indent
    itemsep=1pt,
    topsep=1pt,
    align=right
}
\setlist[itemize,1]{
    itemsep=3pt,
    topsep=0pt
}

\RequirePackage{tasks} % vertically-aligned horizontal list
\settasks{
    label=\arabic*),
    label-align=left,
    label-width=1.5em
}


% -------- TABLE --------
\RequirePackage{hhline, colortbl} % table border
\RequirePackage[export]{adjustbox} % \begin{adjustbox}{width=\columnwidth,center} for scaling tabular
%% export allows valign=c option in \includegraphics inside tabular

\RequirePackage{array} % define column type C,L,R{<len>}
\newcommand{\PreserveBackslash}[1]{\let\temp=\\#1\let\\=\temp}
\newcolumntype{C}[1]{>{\PreserveBackslash\centering}p{#1}}
\newcolumntype{R}[1]{>{\PreserveBackslash\raggedleft}p{#1}}
\newcolumntype{L}[1]{>{\PreserveBackslash\raggedright}p{#1}}

\newcommand{\rowsep}[1]{\vphantom{\parbox[c]{0.5em}{{}\vspace{#1}{}}}} % \rowsep{2.1em}

\newcommand{\itemcolor}[1]{ % switch label color
    \renewcommand{\makelabel}[1]{\color{#1}\hfil ##1}
}

\endinput

setuptext.sty, version 1.2

This package provides options for configuring text.

It must be loaded in the following order:
styles/ setuptext -> thaitext -> setupsci -> setcommand

